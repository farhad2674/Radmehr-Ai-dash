# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# KIE_AI_API_KEY: Optional API Key for direct Kie.ai image generation endpoint
KIE_AI_API_KEY=""

# UPLOADS_DIR: Directory for persistent file storage (defaults to /app/uploads if mounted on PaaS)
UPLOADS_DIR="/app/uploads"

# DATA_DIR: Directory for local persistent JSON database files (defaults to /app/uploads/data or ./data)
DATA_DIR=""
