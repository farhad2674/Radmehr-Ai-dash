# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Optional API key for OpenRouter image generation.
# Without it, the server uses the existing local/Gemini fallback.
OPENROUTER_API_KEY=""

# OpenRouter image-capable model and optional attribution metadata.
OPENROUTER_IMAGE_MODEL="google/gemini-2.5-flash-image-preview"
OPENROUTER_APP_NAME="Radmehr AI Studio"
APP_URL=""
OPENROUTER_RESPONSE_TIMEOUT_MS="240000"

# PostgreSQL foundation. Existing JSON persistence remains active until a later cutover phase.
DATABASE_URL="postgresql://user:password@host:5432/radmehr_ai"
# disable for local development; require for encrypted PaaS connections without CA validation;
# verify-full when the PaaS supplies a trusted certificate chain.
DATABASE_SSL_MODE="require"
DATABASE_POOL_MAX="10"
DATABASE_IDLE_TIMEOUT_MS="30000"
DATABASE_CONNECT_TIMEOUT_MS="10000"

# Optional dedicated integration-test database. Tests skip when this is unset.
TEST_DATABASE_URL=""
TEST_DATABASE_SSL_MODE="disable"

# UPLOADS_DIR: Directory for persistent file storage (defaults to /app/uploads if mounted on PaaS)
UPLOADS_DIR="/app/uploads"

# DATA_DIR: Directory for local persistent JSON database files (defaults to /app/uploads/data or ./data)
DATA_DIR=""
